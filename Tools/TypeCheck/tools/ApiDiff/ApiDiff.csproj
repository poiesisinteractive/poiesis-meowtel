<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compares the public API of a stub assembly with real assemblies: lists stub types/members that do not exist
       (with the same signature) in the real ones. Usage: ApiDiff <stub.dll> <real1.dll> [real2.dll ...] -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>
</Project>
