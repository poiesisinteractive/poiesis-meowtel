<Project>
  <!-- Real third-party package sources (lib/pkgsrc). Same settings as the harness, except that in the Editor
       configuration they are compiled with player defines (no UNITY_EDITOR): their editor-only code paths need the
       UnityEditor API, which the harness does not provide, and their public API does not depend on it. -->
  <Import Project="../Directory.Build.props" />
  <PropertyGroup Condition="'$(Configuration)' == 'Editor'">
    <DefineConstants>$(UnityCommonDefines);$(ProjectScriptingDefines);UNITY_ANDROID;PLATFORM_ANDROID;ENABLE_MONO</DefineConstants>
  </PropertyGroup>
  <PropertyGroup>
    <!-- third-party code: never report its warnings -->
    <WarningLevel>0</WarningLevel>
    <NoWarn>$(NoWarn);CS0618;CS0612;CS0419;CS1574;CS1584;CS1658;CS0628;CS8632</NoWarn>
  </PropertyGroup>
</Project>
